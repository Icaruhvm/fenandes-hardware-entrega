# Copie este arquivo para configuracoes/.env e preencha.
# O .env não entra no Git. Não cole estes valores no index.html.

BLING_CLIENT_ID=
BLING_CLIENT_SECRET=

# Cadastre este mesmo endereço no aplicativo do Bling, em Link de redirecionamento.
# Autorize pelo navegador deste computador. O celular da bancada usa o token daqui.
BLING_REDIRECT_URI=http://127.0.0.1:8080/api/bling/callback
