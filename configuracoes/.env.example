# Valores reais ficam em configuracoes/.env, e esse arquivo não entra no Git.
# Não cole estes valores no index.html.

BLING_CLIENT_ID=
BLING_CLIENT_SECRET=

# Endereço de retorno registrado no aplicativo do Bling.
# A autorização acontece no navegador deste computador.
BLING_REDIRECT_URI=http://127.0.0.1:8080/api/bling/callback
